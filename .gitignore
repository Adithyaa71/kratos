# Build output
/target/
**/*.rs.bk
*.pdb

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# The older Python build this project grew out of. Kept on disk because
# it is real work, out of the repo because it no longer runs -- its `jev`
# package was removed, and everything Kratos needs from it now lives in
# backends/.
/_legacy/

# Local state never belongs in the tree.
#
# The sealed API key and the action log live in %LOCALAPPDATA%\kratos,
# not here, so these are a guard rather than a necessity -- but a DPAPI
# blob is still a credential, and an action log still records what was
# typed into real windows.
config.json
native-host.json
*.jsonl
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/
*.swp

# Working material for the README: renders, frames, samples.
/draft/

# The accuracy corpus is a picture of the operator's own screen.
#
# A UIA dump carries what is on it: the file open in Notepad, the names of
# the files in a folder, the subject lines in a mail client. Useful to
# measure against, not something to commit to a repository -- so the corpus
# is generated locally and the harness skips what is not there.
#
#   cargo run --release -p kratos-native -- --dump "Notepad" > fixtures/uia/notepad.json
/fixtures/uia/

# Model weights are not this repository's to ship.
#
# OmniParser v2's icon detector is AGPL-3.0 and 77MB. It is fetched by hand
# into models/omniparser/icon_detect.onnx, and the detector stays off until
# it is there:
#
#   https://huggingface.co/onnx-community/OmniParser-v2.0_icon_detect
/models/
